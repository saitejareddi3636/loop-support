# Copy to .env.production at the repository root; generate distinct random secrets.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
GEMINI_LIVE_MODEL=gemini-3.8-live
LOOPP_DB_ADMIN_PASSWORD=replace-with-random-admin-password
LOOPP_DB_PASSWORD=replace-with-random-app-password
DATABASE_URL=postgresql://loopp:replace-with-random-app-password@db:5432/loopp?sslmode=verify-full&sslrootcert=/tls/ca.crt
SESSION_RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters
LOOPP_GATEWAY_SECRET=replace-with-a-separate-random-secret
PUBLIC_ORIGIN=https://loopp-support.pages.dev
API_ORIGIN=https://129.80.125.203.sslip.io:8443
LOOPP_TLS_CERT_DIR=/var/lib/docker/volumes/loop-ai_caddy_data/_data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/129.80.125.203.sslip.io
