# Copy to .env at the repository root.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
# Current Live model documented by Google. Override if your account supports a different Live model.
GEMINI_LIVE_MODEL=gemini-3.8-live
# Text agent model. Gemini 2.5 Flash-Lite is unavailable to new API projects.
GEMINI_TEXT_MODEL=gemini-3.5-flash-lite
# Emergency retrieval-only mode: off skips the relevance model, never SQL action guards.
RELEVANCE_VERIFIER=on
POSTGRES_PASSWORD=replace-with-your-local-database-password
DATABASE_URL=postgresql://loopp:replace-with-your-local-database-password@127.0.0.1:55432/loopp
# Local-only controlled failure: set one tool name to demonstrate failure/escalation.
# Ignored entirely when APP_ENV=production. No injection HTTP endpoint exists.
APP_ENV=local
DEMO_FAIL_TOOL=
# Comma-separated origins only when the frontend origin differs from the API host.
ALLOWED_ORIGINS=
# Optional verified operator pricing for this text model, USD per million tokens.
# Gemini 3.5 Flash-Lite has verified list-price defaults. Other models show unavailable unless configured.
TEXT_INPUT_USD_PER_MILLION=
TEXT_OUTPUT_USD_PER_MILLION=
# End-to-end graph budget is 150s. Each model node includes retries within 45s.
MODEL_REQUEST_BUDGET_SECONDS=45
EMBEDDING_REQUEST_BUDGET_SECONDS=45
# Required strong random secret in production; use a secret manager, not source control.
SESSION_RATE_LIMIT_SECRET=
# One Live socket per demo session and three across this single API worker.
VOICE_MAX_PER_SESSION=1
VOICE_MAX_GLOBAL=3
# Creation quotas apply to new sessions only. Existing valid sessions are reused.
# Defaults: local 60/minute, 1000/day per network peer; production 10/minute, 100/day.
SESSION_CREATION_GLOBAL_PER_MINUTE=200
SESSION_CREATION_GLOBAL_PER_DAY=5000
